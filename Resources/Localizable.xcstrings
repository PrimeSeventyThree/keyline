    },
    "error-unexpected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, an unexpected error occurred. Quitting and restarting may help. If this happens again, please submit feedback."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Произошла непредвиденная ошибка. Попробуйте перезапустить процесс. Если эта ошибка возникнет снова, отправьте отзыв."
          }
        }
      }
    },
    "language-restart": {
