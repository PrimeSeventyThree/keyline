    "add-server-body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the access key from your provider. Keys stay on this Mac, in your Keychain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте ключ доступа от вашего провайдера. Ключи хранятся на этом Mac, в вашей Связке ключей."
          }
        }
      }
    },
    "add-server-from-clipboard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found an access key on your clipboard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В буфере обмена найден ключ доступа."
          }
        }
      }
    },
    "add-server-from-link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened from a link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыто по ссылке."
          }
        }
      }
    },
    "auto-connect-body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you’re connected, Keyline turns the VPN back on after your Mac restarts or switches networks, even if Keyline isn’t open. To stop it, disconnect in Keyline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы подключены, Keyline снова включает VPN после перезагрузки Mac или смены сети, даже если Keyline не открыт. Чтобы это прекратить, отключитесь в Keyline."
          }
        }
      }
    },
    "auto-connect-ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Понятно"
          }
        }
      }
    },
    "auto-connect-title": {
      "localizations": {
