          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть Системные настройки"
          }
        }
      }
    },
    "outline-plugin-error-invalid-server-credentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It seems like your access key is not valid. If this happens again, please contact the person who gave it to you."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ доступа недействителен. Если эта ошибка возникнет снова, свяжитесь с пользователем, который предоставил его."
          }
        }
      }
    },
    "outline-plugin-error-server-unreachable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can’t seem to connect to your server. Please check that you are connected to the internet and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к вашему серверу. Проверьте подключение к Интернету и повторите попытку."
          }
        }
      }
    },
    "outline-plugin-error-system-configuration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, it looks like Keyline is not properly installed. Please try installing it again. If that doesn't work, please submit feedback through the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, программа Keyline установлена неправильно. Попробуйте переустановить ее. Если это не поможет, отправьте отзыв через приложение."
          }
        }
      }
    },
    "outline-plugin-error-udp-forwarding-not-enabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It seems like this server doesn’t support UDP forwarding. If this happens again, please contact the person who gave you access."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер не поддерживает переадресацию UDP. Если эта ошибка возникнет снова, свяжитесь с пользователем, который предоставил вам доступ."
          }
        }
      }
    },
    "outline-plugin-error-vpn-permission-not-granted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyline needs your permission to set up a VPN connection to the server. Please try again, or submit feedback if you need help."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyline требуется разрешение для подключения к серверу через сеть VPN. Повторите попытку или отправьте отзыв, чтобы получить помощь."
          }
        }
      }
    },
