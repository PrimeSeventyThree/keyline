    "onboarding-approve-step-1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Open System Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Открыть Системные настройки»."
          }
        }
      }
    },
    "onboarding-approve-step-2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите в раздел %@."
          }
        }
      }
    },
    "onboarding-approve-step-3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Keyline Tunnel, and enter your password if asked."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Keyline Tunnel и при необходимости введите пароль."
          }
        }
      }
    },
    "onboarding-component-body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyline routes your traffic with a network extension. macOS asks you to allow it once."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyline направляет трафик через сетевое расширение. macOS один раз попросит его разрешить."
          }
        }
      }
    },
    "onboarding-component-installing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установка…"
          }
        }
      }
    },
    "onboarding-component-title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the VPN component"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите VPN-компонент"
          }
        }
      }
    },
    "onboarding-component-vpn-prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you first connect, macOS also asks to add a VPN configuration. Choose Allow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При первом подключении macOS также предложит добавить конфигурацию VPN. Нажмите «Разрешить»."
          }
        }
      }
    },
    "onboarding-install": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить"
          }
        }
      }
    },
    "onboarding-privacy-countries": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server countries are looked up offline, on this Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страна сервера определяется офлайн, на этом Mac."
          }
        }
      }
    },
    "onboarding-privacy-keys": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access keys stay on this Mac, in your Keychain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи доступа хранятся на этом Mac, в вашей Связке ключей."
          }
        }
      }
    },
    "onboarding-privacy-no-tracking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyline has no accounts, ads or tracking. It never sends your browsing anywhere but your server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Keyline нет учётных записей, рекламы и слежки. Ваш трафик идёт только на ваш сервер."
          }
        }
      }
    },
    "onboarding-privacy-provider": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever runs your server can see the sites you visit, as with any VPN. Only use servers you trust."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Владелец сервера может видеть, какие сайты вы посещаете, — как и с любым VPN. Используйте только серверы, которым доверяете."
          }
        }
      }
    },
    "onboarding-progress": {
      "localizations": {
        "en": {
