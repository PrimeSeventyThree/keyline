    "onboarding-welcome-body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyline connects you to your own server with an Outline access key, so your traffic goes through a server you trust."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyline подключает вас к вашему серверу по ключу доступа Outline, чтобы трафик шёл через сервер, которому вы доверяете."
          }
        }
      }
    },
    "onboarding-welcome-title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Keyline"
          }
        },
