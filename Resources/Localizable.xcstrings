    "quit-vpn-stays-on-body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your traffic keeps going through your server, and the VPN reconnects after a restart. To turn it off, disconnect first or open Keyline again later."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трафик продолжит идти через ваш сервер, а VPN переподключится после перезагрузки. Чтобы выключить VPN, сначала отключитесь или позже снова откройте Keyline."
          }
        }
      }
    },
