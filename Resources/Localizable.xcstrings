    "report-body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what happened. Keyline opens a new issue on GitHub with your description, the Keyline and macOS versions and, if you choose, crash details. You review it there before sending. Reports never include access keys or server addresses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите, что произошло. Keyline откроет новую задачу на GitHub с вашим описанием, версиями Keyline и macOS и, если хотите, сведениями о сбое. Вы проверите её там перед отправкой. В отчётах никогда нет ключей доступа и адресов серверов."
          }
        }
      }
    },
