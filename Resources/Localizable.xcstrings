    "error-connection-configuration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid configuration. Screenshot the error details and send them to your access key provider."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недопустимая конфигурация. Сделайте скриншот ошибки и отправьте его пользователю, который предоставил вам ключ доступа."
          }
        }
      }
    },
    "error-connection-configuration-fetch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to download the server configuration. Screenshot the error details and send them to your access key provider."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось скачать конфигурацию сервера. Сделайте скриншот ошибки и отправьте его пользователю, который предоставил вам ключ доступа."
          }
        }
      }
    },
    "error-connection-proxy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to connect. Please check your internet connectivity, then screenshot the error details and send them to your access key provider."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться. Проверьте подключение к интернету, сделайте скриншот ошибки и отправьте его пользователю, который предоставил вам ключ доступа."
          }
        }
      }
    },
    "error-invalid-access-key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid access key. Please try again, or submit feedback for help."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недопустимый ключ доступа. Повторите попытку или отправьте отзыв, чтобы получить помощь."
          }
        }
      }
    },
    "error-server-already-added": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
